# Next.js Site URL Configuration
NEXT_PUBLIC_SITE_URL=https://enviroserve.in

# Google Sheet Integration (Google Apps Script Webhook URL)
# Replace with your deployed Web App URL from Google Sheets Apps Script
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional ReTrash Play Store URL
NEXT_PUBLIC_RETRASH_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.retrash.partner&hl=en_IN
